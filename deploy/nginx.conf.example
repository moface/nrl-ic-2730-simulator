# Include inside the HTTPS virtual server. Replace the upstream with your container address.
location ^~ /softhead/ {
    client_max_body_size 4k;
    proxy_pass http://softhead:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 30s;
}
location = /softhead {
    return 308 /softhead/;
}
